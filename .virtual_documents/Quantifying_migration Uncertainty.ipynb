from skimage import feature, segmentation, morphology
from scipy.ndimage import gaussian_filter

from sklearn.cluster import KMeans

def cluster_velocity_model(rtm_image, n_layers=4, base_velocity=1.5e8):
    """
    Use clustering to identify distinct velocity zones
    """
    # Reshape for clustering
    shape = rtm_image.shape
    rtm_flat = rtm_image.flatten().reshape(-1, 1)
    
    # K-means clustering
    kmeans = KMeans(n_clusters=n_layers, random_state=42)
    labels = kmeans.fit_predict(rtm_flat)
    labels = labels.reshape(shape)
    
    # Assign velocities to each cluster
    cluster_centers = kmeans.cluster_centers_.flatten()
    sorted_idx = np.argsort(cluster_centers)
    
    velocity_model = np.zeros_like(rtm_image)
    velocities = np.linspace(base_velocity * 0.8, base_velocity * 1.2, n_layers)
    
    for i, idx in enumerate(sorted_idx):
        velocity_model[labels == idx] = velocities[i]
    
    # Smooth transitions
    from scipy.ndimage import gaussian_filter
    velocity_model = gaussian_filter(velocity_model, sigma=1)
    
    return velocity_model, labels


