import numpy as np

def generate_binary_mask(image):
    a = np.zeros_like(image)
    a[np.where(image<0)] = 0
    a[np.where(image>=0)] = 1
    return a

def iou_binary_masks(I1, I2):
    mask1, mask2 = generate_binary_mask(I1), generate_binary_mask(I2)
    """
    Calculates the Intersection over Union (IoU) for two binary masks.

    Args:
        mask1 (np.ndarray): First binary mask (2D numpy array).
        mask2 (np.ndarray): Second binary mask (2D numpy array).

    Returns:
        float: The IoU score (ranging from 0.0 to 1.0).
    """
    if mask1.shape != mask2.shape:
        raise ValueError("Both masks must have the same shape")

    # Calculate intersection: areas where both masks are 1
    intersection = np.logical_and(mask1, mask2)

    # Calculate union: areas where either mask is 1
    union = np.logical_or(mask1, mask2)

    # Sum the number of non-zero (True) pixels for intersection and union
    intersection_area = np.sum(intersection)
    union_area = np.sum(union)

    # Calculate IoU
    if union_area == 0:
        return 0.0  # Avoid division by zero if both masks are empty
    else:
        return intersection_area / union_area

# Example Usage:
def RMSE(I1, I2):
    l, w = I1.shape
    if I1.shape != I2.shape:
        print('input shapes not the same')
        return None
    else:
        return np.sqrt((1/(1*w))*np.sum((I1.ravel()-I2.ravel())**2))


