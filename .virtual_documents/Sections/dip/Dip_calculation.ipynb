import scipy.ndimage as ndimage
# I think okay to use rectangle as long as we filter out the filled in stuff from .rotate
def rot(M, theta):
    rotated = ndimage.rotate(M.astype(float), theta, reshape=False, cval=np.nan)
    return rotated

def stack2d(M):
    """Return the mean of each row, ignoring nan fill values."""
    return np.nanmean(M, axis=1)  # shape: (nrows,)

# I use rectangular selection instead of circular selection ndimage.rotate would do 
# the same thing to both, but with a circular selection it just wouldn't have to fill 
# in void spaces with NaN. The big argument is that rect might cut off valuable 
# information at the corners (like bellow), but it the selection consists of a 
# continuous reflection this shouldn't such a big issue
def dip_from_rect_selection(selection):
    a = np.zeros(180)
    for theta in np.arange(0, 180, 1):
        rotation = rot(selection, theta)
        row_means = stack2d(rotation)
        a[theta] = np.nanstd(row_means)
    return np.argmax(a)
 


