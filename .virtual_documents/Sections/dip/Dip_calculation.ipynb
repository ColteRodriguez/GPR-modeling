from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg


def make_demo_section(rows=300, cols=500):
    """Generate a demo seismic-like numpy array."""
    x = np.linspace(0, 4 * np.pi, cols)
    z = np.linspace(0, 3 * np.pi, rows)
    X, Z = np.meshgrid(x, z)
    data = (
        np.sin(X) * np.cos(Z * 0.5)
        + 0.4 * np.sin(2.3 * X + 0.7) * np.cos(1.8 * Z)
        + 0.15 * np.random.randn(rows, cols)
    )
    return data.astype(np.float32)


class ImageSelectorApp:
    def __init__(self, root, section: np.ndarray, x_off):
        self.root = root
        self.root.title("Rectangle Selector")
        self.section = section
        self.x_off = x_off

        # Rectangle drag state
        self._drag_start = None   # (x, y) in data coords
        self._rect_patch = None
        self._sel = None          # (col0, row0, col1, row1) in array coords

        self._build_ui()
        self._draw_image()

    # ------------------------------------------------------------------
    # UI construction
    # ------------------------------------------------------------------
    def _build_ui(self):
        self.root.configure(bg="#1a1a2e")

        # Top label
        header = tk.Label(
            self.root,
            text="Draw a rectangle on the image to clip a selection",
            bg="#1a1a2e",
            fg="#e0e0e0",
            font=("Courier", 11),
            pady=6,
        )
        header.pack(side=tk.TOP, fill=tk.X)

        # Matplotlib figure
        self.fig, self.ax = plt.subplots(figsize=(9, 5))
        self.fig.patch.set_facecolor("#0f0f1a")
        self.ax.set_facecolor("#0f0f1a")

        self.canvas = FigureCanvasTkAgg(self.fig, master=self.root)
        self.canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True, padx=8, pady=4)

        # Status bar
        self.status_var = tk.StringVar(value="Click and drag to select a region.")
        status_bar = tk.Label(
            self.root,
            textvariable=self.status_var,
            bg="#0d0d1f",
            fg="#7ecfff",
            font=("Courier", 10),
            anchor="w",
            padx=10,
            pady=4,
        )
        status_bar.pack(side=tk.BOTTOM, fill=tk.X)

        # Button row
        btn_frame = tk.Frame(self.root, bg="#1a1a2e")
        btn_frame.pack(side=tk.BOTTOM, pady=6)

        clip_btn = tk.Button(
            btn_frame,
            text="Clip Selection",
            command=self._clip_selection,
            bg="#2a9d8f",
            fg="white",
            font=("Courier", 10, "bold"),
            relief=tk.FLAT,
            padx=14,
            pady=5,
            cursor="hand2",
        )
        clip_btn.pack(side=tk.LEFT, padx=8)

        clear_btn = tk.Button(
            btn_frame,
            text="Clear",
            command=self._clear_selection,
            bg="#e76f51",
            fg="white",
            font=("Courier", 10, "bold"),
            relief=tk.FLAT,
            padx=14,
            pady=5,
            cursor="hand2",
        )
        clear_btn.pack(side=tk.LEFT, padx=8)

        # Mouse bindings
        self.canvas.mpl_connect("button_press_event", self._on_press)
        self.canvas.mpl_connect("motion_notify_event", self._on_drag)
        self.canvas.mpl_connect("button_release_event", self._on_release)

    # ------------------------------------------------------------------
    # Drawing
    # ------------------------------------------------------------------
    def _draw_image(self):
        self.ax.clear()
        self.ax.tick_params(colors="#888")
        for spine in self.ax.spines.values():
            spine.set_edgecolor("#444")

        self.im = self.ax.imshow(
            self.section,
            aspect="auto",
            cmap="seismic",
            vmin=np.percentile(self.section, 0.1),
            vmax=np.percentile(self.section, 99.9),
        )
        self.ax.set_title("Source Image", color="#cccccc", fontsize=10)
        self.fig.tight_layout()
        self.canvas.draw()

    # ------------------------------------------------------------------
    # Mouse event handlers
    # ------------------------------------------------------------------
    def _on_press(self, event):
        if event.inaxes != self.ax or event.button != 1:
            return
        if self._rect_patch:
            self._rect_patch.remove()
            self._rect_patch = None
            self.canvas.draw_idle()

        self._drag_start = (event.xdata, event.ydata)

    def _on_drag(self, event):
        if self._drag_start is None or event.inaxes != self.ax:
            return
        x0, y0 = self._drag_start
        x1, y1 = event.xdata, event.ydata

        if self._rect_patch:
            self._rect_patch.remove()

        w, h = x1 - x0, y1 - y0
        self._rect_patch = patches.Rectangle(
            (x0, y0), w, h,
            linewidth=1.5,
            edgecolor="#ffe066",
            facecolor="none",
            linestyle="--",
        )
        self.ax.add_patch(self._rect_patch)
        self.canvas.draw_idle()

        r0, r1 = sorted([int(round(y0)), int(round(y1))])
        c0, c1 = sorted([int(round(x0)), int(round(x1))])
        self.status_var.set(
            f"Selection: rows [{r0}:{r1}]  cols [{c0}:{c1}]  ->  shape ({r1-r0} x {c1-c0})"
        )

    def _on_release(self, event):
        if self._drag_start is None or event.inaxes != self.ax or event.button != 1:
            self._drag_start = None
            return

        x0, y0 = self._drag_start
        x1, y1 = event.xdata, event.ydata
        self._drag_start = None

        c0, c1 = sorted([int(round(x0)), int(round(x1))])
        r0, r1 = sorted([int(round(y0)), int(round(y1))])

        rows, cols = self.section.shape
        c0, c1 = max(0, c0), min(cols, c1)
        r0, r1 = max(0, r0), min(rows, r1)

        if c1 - c0 < 2 or r1 - r0 < 2:
            self.status_var.set("Selection too small — try again.")
            return

        self._sel = (c0, r0, c1, r1)
        self.status_var.set(
            f"Selection ready: rows [{r0}:{r1}]  cols [{c0}:{c1}]  ->  shape ({r1-r0} x {c1-c0})   |   Press 'Clip Selection' to extract."
        )

    # ------------------------------------------------------------------
    # Clip / Clear
    # ------------------------------------------------------------------
    def _clip_selection(self):
        if self._sel is None:
            self.status_var.set("No selection yet — draw a rectangle first.")
            return

        c0, r0, c1, r1 = self._sel
        clipped = self.section[r0:r1, c0:c1]

        shape = clipped.shape
        print(f"\n[Clipped selection]  rows [{r0}:{r1}]  cols [{c0}:{c1}]")
        print(f"  -> shape: {shape}")

        self.status_var.set(f"Clipped!  shape = {shape}   (also printed to console)")
        self._show_clip_window(clipped, r0, r1, c0, c1)
        print(f'Apparent dip = {180-dip_from_rect_selection(clipped, dx=dx, dy=dy)} at distance = {(c0+self.x_off)}')
        apparent_dip.append(180-dip_from_rect_selection(clipped, dx=dx, dy=dy))
        print(180-dip_from_rect_selection(clipped, dx=dx, dy=dy))
        distance.append((c0+self.x_off))
        depths.append(r0)
        lengths.append(c1-c0)

    def _show_clip_window(self, clipped, r0, r1, c0, c1):
        print('None')

    def _clear_selection(self):
        if self._rect_patch:
            self._rect_patch.remove()
            self._rect_patch = None
        self._sel = None
        self._drag_start = None
        self.canvas.draw_idle()
        self.status_var.set("Selection cleared — click and drag to start a new one.")


