import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

fig, ax = plt.subplots(1,2, figsize=(15, 5))

def weighted_std(values, weights):
    average = np.average(values, weights=weights)
    # Variance is the weighted average of squared deviations
    variance = np.average((values - average)**2, weights=weights)
    return np.sqrt(variance)

ALGORITHMS = ['Kirchhoff_data', 'FK_data', 'FWI_data']
for alg in ALGORITHMS:
    vals = np.array(data[alg]['true_dip'])
    lengths = np.array(data[alg]['lengths'])

    print(len(vals), len(lengths))
    # --- weights ---
    weights = lengths / np.min(lengths)

    # --- KDE ---
    kde = stats.gaussian_kde(vals, weights=weights, bw_method=0.4)
    xs = np.linspace(vals.min() - 2, vals.max() + 2, 300)
    ys = kde(xs)

    # --- stats ---
    weighted_mean = np.average(vals, weights=weights)

    # weighted median
    sorter = np.argsort(vals)
    sorted_vals = vals[sorter]
    sorted_weights = weights[sorter]
    cumsum = np.cumsum(sorted_weights)
    cutoff = sorted_weights.sum() / 2
    weighted_median = sorted_vals[np.searchsorted(cumsum, cutoff)]

    # --- plot KDE ---
    ax[0].plot(xs, ys, color=COLORS[alg], linewidth=1.5, label=alg, markersize=0)
    print(f'{alg}: mean: {np.mean(weighted_mean)}, median: {np.mean(weighted_median)}, std: {weighted_std(vals, weights)}')

    # --- plot stats ---
    ax[0].axvline(weighted_mean, color=COLORS[alg], linestyle='--',
               linewidth=1.8, alpha=0.9, markersize=0)

    ax[0].axvline(weighted_median, color=COLORS[alg], linestyle='-',
               linewidth=2, alpha=0.9, markersize=0)

# formatting
