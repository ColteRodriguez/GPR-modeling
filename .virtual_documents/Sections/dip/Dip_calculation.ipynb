def plot_wiggle(arr, name, dx=1.0, dt=1.0, scale=2.5, ax=None):
    """
    arr  : 2D array, shape (n_samples, n_traces)
    dx   : horizontal spacing between traces (metres or trace number)
    dt   : vertical sampling interval (ns or metres)
    scale: wiggle amplitude scaling factor
    """
    n_samples, n_traces = arr.shape
    
    if ax is None:
        fig, ax = plt.subplots(figsize=(28, 8))

    t = np.arange(n_samples) * dt
    x = np.arange(n_traces) * dx

    # Normalise so wiggles don't overlap too badly
    max_val = np.percentile(np.abs(arr), 99)
    norm = (arr / max_val) * dx * scale

    for i in range(0, n_traces, 1):
        trace = norm[:, i]
        x_pos = x[i]
        
        # The wiggle line
        ax.plot(x_pos + trace, t, color='black', markersize=0, linewidth=0.2)

        # Shade positive fills only
        ax.fill_betweenx(t, x_pos, x_pos + trace,
                         where=(trace > 0),
                         color='black', linewidth=0)

    ax.set_xlim(x[0] - dx, x[-1] + dx)
    ax.set_ylim(t[-1], t[0])          # time increases downward
    ax.set_xlabel('Distance (m)')
    ax.set_ylabel('Two-way travel time (ns)')
    ax.set_title(f'{name} wiggle trace')
    plt.tight_layout()
    return ax
    
