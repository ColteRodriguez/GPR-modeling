import scipy.ndimage as ndimage
def rot(M, theta):
    rotated = ndimage.rotate(M.astype(float), theta, reshape=False, cval=np.nan)
    return rotated

def stack2d(M):
    """Return the mean of each row, ignoring nan fill values."""
    return np.nanmean(M, axis=1)  # shape: (nrows,)

def dip_from_rect_selection(selection, dx, dy):
    pixel_angles = np.arange(0, 180, 0.5)
    a = np.zeros(len(pixel_angles))

    for i, theta in enumerate(pixel_angles):
        rotation = rot(selection, theta)
        row_means = stack2d(rotation)
        a[i] = np.nanstd(row_means)

    best_theta = pixel_angles[np.argmax(a)]

    # Convert pixel-space angle to physical-space angle
    theta_rad = np.deg2rad(best_theta)
    physical_angle_rad = np.arctan2(dy * np.sin(theta_rad),
                                    dx * np.cos(theta_rad))
    physical_angle_deg = np.rad2deg(physical_angle_rad) % 180

    return physical_angle_deg







def depth_of_penetration(eps):
        velocity_column = 0.3/np.sqrt(np.mean(eps, axis=1))# This is a 1d array where each pixel value is in m/ns
        depth = 0
        ns_per_pixel = 2.5
        for i, pixel in enumerate(velocity_column):
            depth+=(ns_per_pixel*pixel)
        return depth/2
    
