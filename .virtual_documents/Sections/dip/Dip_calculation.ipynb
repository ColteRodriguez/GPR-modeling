distrib_y, distrib_x = distribs_y[0::3], distribs_x[0::3]
# Define a common x-grid spanning the full range across all distributions
x_min = min(x.min() for x in distrib_x)
x_max = 25
common_x = np.linspace(x_min, x_max, 500)  # adjust resolution as needed

# Interpolate each distribution onto the common grid
heatmap = np.zeros((len(distrib_x), len(common_x)))

def taper(y, alpha=0.2):
    """Apply a cosine taper to the edges of y. 
    alpha controls the fraction of the signal tapered (0.1–0.3 works well)."""
    window = windows.tukey(len(y), alpha=alpha)
    return y * window

for t, (x, y) in enumerate(zip(distrib_x, distrib_y)):
    y_tapered = taper(y, alpha=0.2)
    f = interp1d(x, y_tapered, bounds_error=False, fill_value=0.0)
    heatmap[t] = f(common_x)
    
