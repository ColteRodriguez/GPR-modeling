import matplotlib.pyplot as plt
import numpy as np

# Example data
x = np.linspace(0, 299, 1)
n_traces = 5  # number of stacked plots
sources = [1, 5, 10, 15, 20, 25, 30, 35]
traces_plot= []
for i in range(n_traces):
    dt = 1e-9
    t_max = 300e-9
    f0 = 2.5e7
    np.random.seed(1001)
    radargram, x, t = gpr_finite_difference_abc(
        eps.T,
        dx=dx,
        dz=dz,
        dt=dt,
        t_max=t_max,
        f0=f0,
        trace_spacing=2,
        SNR=np.inf,
        source_idx=sources[i]
    )
    
    traces_plot.append(radargram.T[25])


# Create stacked plot
fig, axes = plt.subplots(n_traces, 1, figsize=(10, 7), sharex=True)

# Vertical spacing between plots
offset = 12  # adjust this to control spacing

for i, (ax, trace) in enumerate(zip(axes, traces_plot)):
    # Plot trace centered at y=0 for each subplot
    ax.plot(trace/np.max(trace), 'k-', linewidth=1.5)
    
    # Add horizontal line at y=0 for reference
    ax.axhline(0, color='black', linewidth=0.5, alpha=1)
    
    # Set y-limits to keep plots consistent
    ax.set_ylim(-1, 1)
    
    # Remove y-axis labels/ticks for cleaner look
    ax.set_yticks([])
    
    # Remove space between subplots
    ax.spines['top'].set_visible(False)
    if i < n_traces - 1:
        ax.spines['bottom'].set_visible(False)

# Add common labels
axes[-1].set_xlabel('Travel Time [ns]', fontsize=12)


plt.subplots_adjust(hspace=0.01)  # minimal vertical spacing
plt.show()


